# Copy this file to `.env` and adjust if needed.
# `.env` is gitignored (never commit real config/secrets); this template is committed.
#
# Node 20.6+ loads .env automatically when started with `--env-file`, but for
# simplicity our code reads these via process.env (see src/llm.ts). tsx also
# supports --env-file if we want automatic loading later.

# --- LLM gateway ---
# chat_completions: OpenAI-compatible /v1/chat/completions style endpoint.
# responses: OpenAI/Azure /responses style endpoint.
# copilot_sdk: GitHub Copilot SDK runtime. Uses COPILOT_MODEL instead of LLM_MODEL.
LLM_API_MODE=chat_completions
LLM_BASE_URL=http://localhost:4399/v1
LLM_MODEL=gpt-4o-2024-11-20

# If a future endpoint requires auth, put the key here (left blank for the
# local gateway which ignores it).
LLM_API_KEY=
LLM_API_KEY_HEADER=Authorization

# Optional direct multimodal Responses endpoint used by Companion screenshots
# and image generation. When omitted, LLM_BASE_URL / LLM_MODEL are reused.
LLM_VISUAL_BASE_URL=
LLM_VISUAL_MODEL=
# Preferred for Azure gpt-image deployments: the complete deployment-specific
# /images/generations URL, including api-version. Image-specific credentials
# are optional; when omitted, LLM_API_KEY / LLM_API_KEY_HEADER are reused.
LLM_IMAGE_BASE_URL=
LLM_IMAGE_MODEL=
LLM_IMAGE_API_KEY=
LLM_IMAGE_API_KEY_HEADER=
# Required only when image generation falls back to Azure Responses API.
LLM_IMAGE_DEPLOYMENT=

# --- GitHub Copilot SDK ---
# Enable with: LLM_API_MODE=copilot_sdk
# Requires `npm install` after adding @github/copilot-sdk. Auth uses the logged-in
# Copilot CLI user by default, or set COPILOT_GITHUB_TOKEN/GH_TOKEN/GITHUB_TOKEN.
COPILOT_MODEL=gpt-5.6-sol
# Optional: connect to an already-running Copilot runtime server.
COPILOT_RUNTIME_URI=
COPILOT_RUNTIME_TOKEN=
# Optional: override SDK runtime state directory. If unset, the SDK default applies.
COPILOT_BASE_DIRECTORY=
COPILOT_LOG_LEVEL=
# Set to 1 only if you want SDK-managed infinite-session state for each request.
COPILOT_INFINITE_SESSIONS=0

# --- Context budget ---
# Tool results longer than this are saved to .jesse/tool-results/ and replaced
# with a short preview plus the local file path in model context.
TOOL_RESULT_MAX_CHARS=12000

# --- Microsoft Graph connector ---
# Optional. If unset on macOS, microsoft_graph reads a short-lived token from
# an already signed-in Chrome Outlook tab. For production OAuth/MSAL, inject a
# delegated Graph access token here instead of relying on Chrome local storage.
MICROSOFT_GRAPH_TOKEN=
# Optional fallback token for the Outlook REST API. This is only needed when
# the Graph token does not include Mail.Read; Chrome extraction finds the
# Outlook-scoped token automatically for the local prototype.
MICROSOFT_OUTLOOK_TOKEN=

# Character-based context warning threshold. When exceeded, the CLI suggests
# running /compact but does not compact automatically.
CONTEXT_WARN_CHARS=120000

# --- Manual compaction ---
# Number of latest messages preserved verbatim after /compact.
COMPACT_KEEP_RECENT_MESSAGES=8

# Maximum characters from older messages sent into the compaction request.
# This protects the compaction call itself from becoming too large.
COMPACT_SOURCE_MAX_CHARS=90000
# Optional root for managed Scratch and Projects workspaces.
# Defaults to ~/JesseAgent.
JESSE_WORKSPACE_HOME=
