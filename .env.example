# Copy this file to `.env` and adjust if needed.
# `.env` is gitignored (never commit real config/secrets); this template is committed.
#
# Node 20.6+ loads .env automatically when started with `--env-file`, but for
# simplicity our code reads these via process.env (see src/llm.ts). tsx also
# supports --env-file if we want automatic loading later.

# --- LLM gateway ---
# chat_completions: OpenAI-compatible /v1/chat/completions style endpoint.
# responses: OpenAI/Azure /responses style endpoint.
LLM_API_MODE=chat_completions
LLM_BASE_URL=http://localhost:4399/v1
LLM_MODEL=gpt-4o-2024-11-20

# If a future endpoint requires auth, put the key here (left blank for the
# local gateway which ignores it).
LLM_API_KEY=
LLM_API_KEY_HEADER=Authorization

# --- Context budget ---
# Tool results longer than this are saved to .jesse/tool-results/ and replaced
# with a short preview plus the local file path in model context.
TOOL_RESULT_MAX_CHARS=12000

# Character-based context warning threshold. When exceeded, the CLI suggests
# running /compact but does not compact automatically.
CONTEXT_WARN_CHARS=120000

# --- Manual compaction ---
# Number of latest messages preserved verbatim after /compact.
COMPACT_KEEP_RECENT_MESSAGES=8

# Maximum characters from older messages sent into the compaction request.
# This protects the compaction call itself from becoming too large.
COMPACT_SOURCE_MAX_CHARS=90000
